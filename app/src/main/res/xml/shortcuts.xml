<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_qr_scan"
        android:enabled="true"
        android:icon="@drawable/ic_scan_tile"
        android:shortcutShortLabel="@string/shortcut_qr"
        android:shortcutLongLabel="@string/shortcut_qr_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.anamolqr.scnr"
            android:targetClass="com.example.MainActivity">
            <extra android:name="LAUNCH_MODE" android:value="SCAN" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="quick_history"
        android:enabled="true"
        android:icon="@drawable/ic_scan_tile"
        android:shortcutShortLabel="@string/nav_history"
        android:shortcutLongLabel="@string/history_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.anamolqr.scnr"
            android:targetClass="com.example.MainActivity">
            <extra android:name="LAUNCH_MODE" android:value="HISTORY" />
        </intent>
    </shortcut>
</shortcuts>
